{
  "name": "producer-tools",
  "main": "electron-main.cjs",
  "build": {
    "appId": "com.producer.tools",
    "productName": "Producer Tools",
    "files": [
      "dist/**",
      "electron-main.cjs",
      "build/icon.ico",
      "logo_for_Producer_Tools_app_202606152238.jpeg"
    ],
    "extraResources": [],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    }
  },
  "description": "Producer Tools Suite - Professional audio production tools for music creators",
  "author": "Producer Tools",
  "private": true,
  "version": "8.4.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --external:vite --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit",
    "build:electron": "npm run build && node build-icon.cjs",
    "package:win": "npm run build:electron && electron-builder --win"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/multer": "^2.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "audiobuffer-to-wav": "^1.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fft.js": "^4.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "praat-wasm": "^6.4.6200",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@types/audiobuffer-to-wav": "^1.0.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "playwright": "^1.61.1",
    "png-to-ico": "^3.0.1",
    "rimraf": "^5.0.0",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
